[Unit]
Description=KXDEX Backend Service
After=network.target

[Service]
Type=simple
User=hqsk
Group=hqsk
WorkingDirectory=/home/hqsk/kxdex

# Java 启动命令
ExecStart=/usr/bin/java \
  -Xms512m \
  -Xmx2g \
  -XX:+UseG1GC \
  -XX:MaxGCPauseMillis=200 \
  -jar /home/hqsk/kxdex/wallet-backend.jar \
  --spring.profiles.active=prod

# 重启策略
Restart=on-failure
RestartSec=10

# 日志输出
StandardOutput=append:/home/hqsk/kxdex/logs/backend.log
StandardError=append:/home/hqsk/kxdex/logs/backend-error.log

# 环境变量
Environment="JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64"
Environment="FISCO_HOME=/home/hqsk/fisco"

# 安全设置
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
